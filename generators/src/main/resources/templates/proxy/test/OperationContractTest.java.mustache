    @Test
    void validRequestIsSentAsSoapAndTheResponseComesBackAsJson() throws Exception {
        OperationModel op = op();
        for (long seed = 1; seed <= 5; seed++) {
            Object request = sample(op.input().typeId(), seed);
            Object response = sample(op.output().typeId(), seed + 1000);
            STUB.reply(200, StubSoapServer.envelope(converter.toXml(op.output(), response)));

            byte[] body = client().body(json(request))
                    .when().post(PATH)
                    .then().statusCode(200).contentType(startsWith("application/json"))
                    .extract().asByteArray();

            assertThat(canonical(op.output(), parse(body))).as("response, seed %d", seed).isEqualTo(response);
            assertThat(STUB.last().soapAction()).isEqualTo("\"" + op.soapAction() + "\"");
            assertThat(STUB.last().contentType()).startsWith("text/xml");
            Element payload = STUB.lastPayload();
            assertThat(payload.getLocalName()).isEqualTo(op.input().localName());
            assertThat(converter.toJson(op.input(), payload)).as("request, seed %d", seed)
                    .isEqualTo(canonical(op.input(), request));
        }
    }
