package {{package}};

import com.fasterxml.jackson.databind.DeserializationFeature;
import com.fasterxml.jackson.databind.json.JsonMapper;
import dev.soapnecromancer.runtime.JsonXmlConverter;
import dev.soapnecromancer.runtime.ModelArbitraries;
import dev.soapnecromancer.runtime.RoundTripAssertions;
import dev.soapnecromancer.runtime.RuntimeXml;
import dev.soapnecromancer.runtime.XmlRenderer;
import dev.soapnecromancer.runtime.model.*;
import net.jqwik.api.*;

import java.io.IOException;
import java.io.InputStream;
import java.io.UncheckedIOException;
import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;
import java.util.Random;

import static org.assertj.core.api.Assertions.assertThat;

/**
 * JSON <-> XML round-trip properties for every operation of this service, run against the exact
 * converter this generated proxy ships. Generated by SOAP Necromancer; converter spec Requirement 3.
 * Try count: -Djqwik.tries=N (default in pom.xml).
 */
@Tag("fast")
class RoundTripProperties {
    private static final ServiceModel MODEL = loadModel();
    private static final JsonXmlConverter CONVERTER = new JsonXmlConverter(MODEL);

    record Case(ElementRef root, Object value) {}

    private static ServiceModel loadModel() {
        try (InputStream in = RoundTripProperties.class.getResourceAsStream("/model.json")) {
            return JsonMapper.builder().enable(DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS).build()
                    .readValue(in, ServiceModel.class);
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
    }

    @Provide
    Arbitrary<Case> messages() {
        List<Arbitrary<Case>> all = new ArrayList<>();
        for (OperationModel op : MODEL.operations()) {
            for (ElementRef ref : List.of(op.input(), op.output())) {
                all.add(ModelArbitraries.values(MODEL, ref.typeId()).map(v -> new Case(ref, v)));
            }
        }
        return Arbitraries.oneOf(all);
    }

    /** 3.1: toJson(toXml(v)) == v. */
    @Property
    void jsonToXmlToJsonIsLossless(@ForAll("messages") Case c) {
        assertThat(CONVERTER.toJson(c.root(), CONVERTER.toXml(c.root(), c.value()))).isEqualTo(c.value());
    }

    /** 3.2: any legal backend rendering (prefixes, whitespace, CDATA) reads back to v. */
    @Property
    void anyBackendRenderingReadsBack(@ForAll("messages") Case c, @ForAll Random random) {
        String xml = new XmlRenderer(MODEL, random).render(c.root(), c.value());
        assertThat(CONVERTER.toJson(c.root(), xml)).as(xml).isEqualTo(c.value());
    }

    /** 3.3: absent optionals produce no element. */
    @Property
    void absentOptionalsStayAbsent(@ForAll("messages") Case c) throws Exception {
        String xml = CONVERTER.toXml(c.root(), c.value());
        RoundTripAssertions.assertAbsentOptionalsHaveNoElement(MODEL, c.root().typeId(), c.value(),
                RuntimeXml.parse(xml).getDocumentElement());
    }

    /** 3.6: decimals keep every digit and their scale. */
    @Property
    void decimalsSurviveExactly(@ForAll("decimals") BigDecimal amount) {
        ElementRef ref = new ElementRef("urn:test", "Amount", "xs:decimal");
        ServiceModel m = new ServiceModel("T", "urn:test", null,
                List.of(new OperationModel("Op", "", "", ref, ref)),
                Map.of("xs:decimal", TypeModel.builtIn(BuiltIn.DECIMAL)));
        JsonXmlConverter c = new JsonXmlConverter(m);
        BigDecimal back = (BigDecimal) c.toJson(ref, c.toXml(ref, amount));
        assertThat(back.unscaledValue()).isEqualTo(amount.unscaledValue());
        assertThat(back.scale()).isEqualTo(amount.scale());
    }

    @Provide
    Arbitrary<BigDecimal> decimals() {
        return ModelArbitraries.decimals();
    }
}
