package {{package}};

import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpServer;
import dev.soapnecromancer.runtime.RuntimeXml;
import org.w3c.dom.Element;
import org.w3c.dom.Node;

import java.io.IOException;
import java.io.UncheckedIOException;
import java.net.InetAddress;
import java.net.InetSocketAddress;
import java.nio.charset.StandardCharsets;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Stand-in SOAP {{soapVersionLabel}} backend for the generated contract tests: records every request
 * and answers with whatever the test configured. Lets the tests run with no real SOAP endpoint
 * (Requirement 3.6).
 */
final class StubSoapServer {
    static final String SOAP_ENV = {{envelopeNsJava}};
    /** Media type of requests and replies for this service's SOAP version. */
    static final String MEDIA_TYPE = {{mediaTypeJava}};
    static final String CLIENT_FAULT = {{#soap12}}"soap:Sender"{{/soap12}}{{^soap12}}"soap:Client"{{/soap12}};
    static final String SERVER_FAULT = {{#soap12}}"soap:Receiver"{{/soap12}}{{^soap12}}"soap:Server"{{/soap12}};
    /** SOAP 1.1 sends every fault with HTTP 500; the SOAP 1.2 HTTP binding sends Sender faults with 400. */
    static final int CLIENT_FAULT_STATUS = {{#soap12}}400{{/soap12}}{{^soap12}}500{{/soap12}};

    /** {@code action} is what the client sent as the SOAP action, quotes included, or null. */
    record Received(String action, String contentType, String body) {}

    private final HttpServer server;
    private final List<Received> received = new CopyOnWriteArrayList<>();
    private volatile int status;
    private volatile String reply;

    private StubSoapServer() {
        try {
            server = HttpServer.create(new InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0);
        } catch (IOException e) {
            throw new UncheckedIOException(e);
        }
        server.createContext("/soap", exchange -> {
            String body = new String(exchange.getRequestBody().readAllBytes(), StandardCharsets.UTF_8);
            String contentType = exchange.getRequestHeaders().getFirst("Content-Type");
            received.add(new Received(action(exchange, contentType), contentType, body));
            byte[] out = reply.getBytes(StandardCharsets.UTF_8);
            exchange.getResponseHeaders().add("Content-Type", MEDIA_TYPE + "; charset=utf-8");
            exchange.sendResponseHeaders(status, out.length);
            exchange.getResponseBody().write(out);
            exchange.close();
        });
        reset();
        server.start();
    }
{{#soap12}}

    private static final Pattern ACTION = Pattern.compile(";\\s*action=(\"(?:[^\"\\\\]|\\\\.)*\")");

    /** SOAP 1.2: the action is a parameter of the Content-Type, there is no SOAPAction header. */
    private static String action(HttpExchange exchange, String contentType) {
        if (exchange.getRequestHeaders().containsKey("SOAPAction"))
            throw new AssertionError("a SOAP 1.2 request must not carry a SOAPAction header");
        Matcher m = ACTION.matcher(contentType == null ? "" : contentType);
        return m.find() ? m.group(1) : null;
    }
{{/soap12}}
{{^soap12}}

    /** SOAP 1.1: the action is the SOAPAction header. */
    private static String action(HttpExchange exchange, String contentType) {
        return exchange.getRequestHeaders().getFirst("SOAPAction");
    }
{{/soap12}}

    static StubSoapServer start() {
        return new StubSoapServer();
    }

    String url() {
        return "http://127.0.0.1:" + server.getAddress().getPort() + "/soap";
    }

    /** Forget requests; until configured, answer every call with a server fault. */
    void reset() {
        received.clear();
        reply(500, fault(SERVER_FAULT, "stub reply not configured"));
    }

    void reply(int status, String body) {
        this.status = status;
        this.reply = body;
    }

    int requestCount() {
        return received.size();
    }

    Received last() {
        if (received.isEmpty()) throw new AssertionError("the stub SOAP server received no request");
        return received.get(received.size() - 1);
    }

    /** First element inside soap:Body of the last request. */
    Element lastPayload() throws Exception {
        Element env = RuntimeXml.parse(last().body()).getDocumentElement();
        if (!SOAP_ENV.equals(env.getNamespaceURI()))
            throw new AssertionError("expected a SOAP {{soapVersionLabel}} envelope: " + last().body());
        for (Node b = env.getFirstChild(); b != null; b = b.getNextSibling()) {
            if (b instanceof Element body && "Body".equals(body.getLocalName())) {
                for (Node n = body.getFirstChild(); n != null; n = n.getNextSibling()) {
                    if (n instanceof Element e) return e;
                }
            }
        }
        throw new AssertionError("no payload in soap:Body: " + last().body());
    }

    static String envelope(String payload) {
        return "<?xml version=\"1.0\" encoding=\"UTF-8\"?><soap:Envelope xmlns:soap=\"" + SOAP_ENV + "\"><soap:Body>"
                + payload + "</soap:Body></soap:Envelope>";
    }

    static String fault(String code, String message) {
        String text = message.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;");
{{#soap12}}
        return envelope("<soap:Fault><soap:Code><soap:Value>" + code + "</soap:Value></soap:Code>"
                + "<soap:Reason><soap:Text xml:lang=\"en\">" + text + "</soap:Text></soap:Reason></soap:Fault>");
{{/soap12}}
{{^soap12}}
        return envelope("<soap:Fault><faultcode>" + code + "</faultcode><faultstring>" + text
                + "</faultstring></soap:Fault>");
{{/soap12}}
    }
}
