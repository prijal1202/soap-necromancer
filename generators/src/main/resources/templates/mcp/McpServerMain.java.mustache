package {{package}};

import io.modelcontextprotocol.json.jackson3.JacksonMcpJsonMapper;
import io.modelcontextprotocol.server.McpServer;
import io.modelcontextprotocol.server.McpServerFeatures.SyncToolSpecification;
import io.modelcontextprotocol.server.transport.StdioServerTransportProvider;
import io.modelcontextprotocol.spec.McpSchema;
import io.modelcontextprotocol.spec.McpSchema.CallToolResult;
import io.modelcontextprotocol.spec.McpSchema.ServerCapabilities;
import io.modelcontextprotocol.spec.McpSchema.Tool;
import tools.jackson.core.StreamWriteFeature;
import tools.jackson.core.type.TypeReference;
import tools.jackson.databind.DeserializationFeature;
import tools.jackson.databind.cfg.JsonNodeFeature;
import tools.jackson.databind.json.JsonMapper;

import java.io.InputStream;
import java.net.ConnectException;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.net.http.HttpTimeoutException;
import java.nio.charset.StandardCharsets;
import java.time.Duration;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * Generated MCP server for SOAP service {{serviceNameDoc}}: one tool per SOAP operation, served over
 * stdio. Each tool call is forwarded as JSON to the generated proxy ({@code PROXY_URL}), which talks
 * SOAP. This server never talks SOAP itself. Generated by SOAP Necromancer {{generatorVersion}}.
 *
 * <p>stdout is the MCP protocol channel: nothing else may be printed there. Logs go to stderr.
 */
public final class McpServerMain {

    /**
     * Decimals stay BigDecimal end to end (docs/decisions.md section 7): the SDK's default mapper
     * would turn 1234567890.123456789 into the double 1.2345678901234567E9.
     */
    static final JsonMapper JSON = JsonMapper.builder()
            .enable(DeserializationFeature.USE_BIG_DECIMAL_FOR_FLOATS)
            .disable(JsonNodeFeature.STRIP_TRAILING_BIGDECIMAL_ZEROES)
            .enable(StreamWriteFeature.WRITE_BIGDECIMAL_AS_PLAIN)
            .build();

    private McpServerMain() {}

    public static void main(String[] args) throws Exception {
        String proxyUrl = System.getenv().getOrDefault("PROXY_URL", "http://localhost:8080").replaceAll("/+$", "");
        HttpClient http = HttpClient.newBuilder()
                .version(HttpClient.Version.HTTP_1_1)
                .connectTimeout(Duration.ofSeconds(5))
                .build();

        List<Map<String, Object>> tools;
        try (InputStream in = McpServerMain.class.getResourceAsStream("/tools.json")) {
            tools = JSON.readValue(in, new TypeReference<List<Map<String, Object>>>() {});
        }

        List<SyncToolSpecification> specs = new ArrayList<>();
        for (Map<String, Object> t : tools) {
            String name = (String) t.get("name");
            String operation = (String) t.get("operation");
            boolean wrapped = Boolean.TRUE.equals(t.get("wrapped"));
            @SuppressWarnings("unchecked")
            Map<String, Object> schema = (Map<String, Object>) t.get("inputSchema");
            specs.add(SyncToolSpecification.builder()
                    .tool(Tool.builder(name, schema).description((String) t.get("description")).build())
                    .callHandler((exchange, request) -> call(http, proxyUrl, operation, wrapped, request.arguments()))
                    .build());
        }

        JacksonMcpJsonMapper mapper = new JacksonMcpJsonMapper(JSON);
        McpServer.sync(new StdioServerTransportProvider(mapper))
                .jsonMapper(mapper)
                .serverInfo({{serverNameJava}}, "1.0.0")
                .capabilities(ServerCapabilities.builder().tools(false).build())
                .tools(specs.toArray(new SyncToolSpecification[0]))
                .build();
        System.err.println("[mcp] " + specs.size() + " tools ready; forwarding to the generated proxy at " + proxyUrl);
    }

    /** Forwards one tool call to POST {proxyUrl}/{operation}. Errors become isError results, never exceptions. */
    static CallToolResult call(HttpClient http, String proxyUrl, String operation, boolean wrapped,
                               Map<String, Object> arguments) {
        try {
            Object payload = wrapped ? (arguments == null ? null : arguments.get("value"))
                    : (arguments == null ? Map.of() : arguments);
            HttpRequest request = HttpRequest.newBuilder(URI.create(proxyUrl + "/" + operation))
                    .timeout(Duration.ofSeconds(60))
                    .header("Content-Type", "application/json")
                    .header("Accept", "application/json, application/problem+json")
                    .POST(HttpRequest.BodyPublishers.ofString(JSON.writeValueAsString(payload), StandardCharsets.UTF_8))
                    .build();
            HttpResponse<String> response = http.send(request, HttpResponse.BodyHandlers.ofString(StandardCharsets.UTF_8));
            if (response.statusCode() / 100 == 2) return result(response.body(), false);
            return result(problem(response), true);
        } catch (ConnectException e) {
            return result("The generated proxy is not reachable at " + proxyUrl + ". Start it, or set PROXY_URL.", true);
        } catch (HttpTimeoutException e) {
            return result("The generated proxy did not answer within 60 seconds.", true);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            return result("Interrupted.", true);
        } catch (Exception e) {
            return result("Call failed: " + e.getClass().getSimpleName() + ": " + e.getMessage(), true);
        }
    }

    /** Human-readable summary of the generated proxy's RFC 7807 Problem response. */
    static String problem(HttpResponse<String> response) {
        StringBuilder b = new StringBuilder("HTTP ").append(response.statusCode());
        try {
            Map<String, Object> p = JSON.readValue(response.body(), new TypeReference<Map<String, Object>>() {});
            for (String key : List.of("title", "detail", "path", "faultcode", "faultstring")) {
                if (p.get(key) != null) b.append("; ").append(key).append(": ").append(p.get(key));
            }
        } catch (Exception notJson) {
            // keep the status only
        }
        return b.toString();
    }

    private static CallToolResult result(String text, boolean isError) {
        return CallToolResult.builder().content(List.of(new McpSchema.TextContent(text))).isError(isError).build();
    }
}
